# STEP 3: INDEXING & QUERY OPTIMISATION  (CO3)
# ===============================================================
def demo_indexing(conn):
    banner("STEP 3: Indexing & query optimisation")
    cur = conn.cursor()
    queries = {
        "Customer purchase history (point lookup)": """
            SELECT p.name, SUM(oi.quantity) AS units
            FROM orders o
            JOIN order_items oi ON oi.order_id = o.order_id
            JOIN products p     ON p.product_id = oi.product_id
            WHERE o.customer_id = 1234
            GROUP BY p.name ORDER BY units DESC""",
        "Monthly revenue by region (range scan)": """
            SELECT c.region, SUM(oi.quantity * p.price) AS revenue
            FROM orders o
            JOIN customers c    ON c.customer_id = o.customer_id
            JOIN order_items oi ON oi.order_id   = o.order_id
            JOIN products p     ON p.product_id  = oi.product_id
            WHERE o.order_date BETWEEN '2024-06-01' AND '2024-06-07'
            GROUP BY c.region""",
    }

    def run_timed(q, reps=30):
        cur.execute(q).fetchall()                    # warm-up
        t = time.perf_counter()
        for _ in range(reps):
            cur.execute(q).fetchall()
        return (time.perf_counter() - t) / reps * 1000

    for idx in ("idx_orders_date", "idx_orders_customer", "idx_items_product"):
        cur.execute(f"DROP INDEX IF EXISTS {idx}")
    conn.commit()

    before = {}
    for name, q in queries.items():
        print(f"--- BEFORE index: {name} ---")
        for row in cur.execute("EXPLAIN QUERY PLAN " + q):
            print("   ", row[-1])
        before[name] = run_timed(q)

    cur.execute("CREATE INDEX idx_orders_date     ON orders(order_date)")
    cur.execute("CREATE INDEX idx_orders_customer ON orders(customer_id)")
    cur.execute("CREATE INDEX idx_items_product   ON order_items(product_id)")
    conn.commit()
    cur.execute("ANALYZE")

    rows = []
    for name, q in queries.items():
        print(f"\n--- AFTER index: {name} ---")
        for row in cur.execute("EXPLAIN QUERY PLAN " + q):
            print("   ", row[-1])
        after = run_timed(q)
        sp = before[name] / max(after, 1e-9)
        print(f"   Time: {before[name]:.3f} ms -> {after:.3f} ms  "
              f"(speed-up {sp:.1f}x)")
        rows.append({"query": name, "no_index_ms": before[name],
                     "with_index_ms": after, "speedup": sp})

    df = pd.DataFrame(rows)
    df.to_csv(f"{OUT_DIR}/index_performance.csv", index=False)

    x = np.arange(len(df))
    plt.figure(figsize=(7, 4))
    plt.bar(x - 0.2, df["no_index_ms"], 0.4, label="No index", color="#d9534f")
    plt.bar(x + 0.2, df["with_index_ms"], 0.4, label="With index", color="#5cb85c")
    plt.xticks(x, ["Point lookup", "Range scan"])
    plt.ylabel("Avg query time (ms)")
    plt.title("Effect of Indexing on Query Performance")
    plt.legend()
    plt.tight_layout()
    plt.savefig(f"{OUT_DIR}/index_performance.png", dpi=120)
    plt.close()


# ===============================================================
# STEP 4: DISTRIBUTED DATABASE SIMULATION  (CO1, CO4, CO5)
#   Horizontal fragmentation by REGION -> one shard per region.
#   Query is executed on every shard (scatter) and merged (gather).
# ===============================================================
def demo_distributed(conn):
    banner("STEP 4: Distributed DB - horizontal fragmentation (sharding)")
    shards = {}
    for region in REGIONS:
        s = sqlite3.connect(":memory:")
        s.executescript("""
            CREATE TABLE customers (customer_id INTEGER PRIMARY KEY, name TEXT,
                                    region TEXT, join_date TEXT);
            CREATE TABLE orders (order_id INTEGER PRIMARY KEY,
                                 customer_id INTEGER, order_date TEXT);
            CREATE TABLE order_items (order_id INTEGER, product_id INTEGER,
                                      quantity INTEGER);
            CREATE TABLE products (product_id INTEGER PRIMARY KEY, name TEXT,
                                   category TEXT, price REAL);   -- replicated
        """)
        shards[region] = s

    # Replicate small dimension table (products) to every shard
    prods = conn.execute("SELECT * FROM products").fetchall()
    for s in shards.values():
        s.executemany("INSERT INTO products VALUES (?,?,?,?)", prods)

    # Fragment large tables by region
    for region, s in shards.items():
        cust = conn.execute(
            "SELECT * FROM customers WHERE region=?", (region,)).fetchall()
        s.executemany("INSERT INTO customers VALUES (?,?,?,?)", cust)
        orders = conn.execute("""SELECT o.* FROM orders o JOIN customers c
                                 ON c.customer_id=o.customer_id
                                 WHERE c.region=?""", (region,)).fetchall()
        s.executemany("INSERT INTO orders VALUES (?,?,?)", orders)
        oi = conn.execute("""SELECT oi.* FROM order_items oi
                             JOIN orders o ON o.order_id=oi.order_id
                             JOIN customers c ON c.customer_id=o.customer_id
                             WHERE c.region=?""", (region,)).fetchall()
        s.executemany("INSERT INTO order_items VALUES (?,?,?)", oi)
        s.commit()
        print(f"Shard [{region:<5}] -> {len(cust):>5,} customers | "
              f"{len(orders):>6,} orders | {len(oi):>7,} items")

    # Global query: revenue per category
    q = """SELECT p.category, SUM(oi.quantity * p.price)
           FROM order_items oi JOIN products p ON p.product_id = oi.product_id
           GROUP BY p.category"""

    # Scatter-gather: run on every shard, then merge partial results
    def scatter_gather():
        out = {}
        for sh in shards.values():
            for cat, rev in sh.execute(q):
                out[cat] = out.get(cat, 0) + rev
        return out

    def best_ms(fn, reps=5):
        best = 1e9
        for _ in range(reps):
            t = time.perf_counter()
            fn()
            best = min(best, time.perf_counter() - t)
        return best * 1000

    merged = scatter_gather()
    central = dict(conn.execute(q).fetchall())
    t_dist = best_ms(scatter_gather)
    t_cent = best_ms(lambda: conn.execute(q).fetchall())
    print("(Shards are simulated on one machine; on real nodes they would"
          " run in parallel.)")

    # CO4: consistency check
    consistent = all(abs(central[k] - merged[k]) < 1e-6 for k in central)
    print(f"\nCentralised query: {t_cent:.2f} ms | "
          f"Scatter-gather query: {t_dist:.2f} ms")
    print("Consistency check (central == merged shards):",
          "PASSED" if consistent else "FAILED")

    df = pd.DataFrame(sorted(merged.items(), key=lambda x: -x[1]),
                      columns=["category", "revenue"])
    df.to_csv(f"{OUT_DIR}/revenue_by_category.csv", index=False)
    plt.figure(figsize=(8, 4))
    plt.barh(df["category"][::-1], df["revenue"][::-1], color="#337ab7")
    plt.xlabel("Revenue")
    plt.title("Revenue by Category (merged from distributed shards)")
    plt.tight_layout()
    plt.savefig(f"{OUT_DIR}/revenue_by_category.png", dpi=120)
    plt.close()


# ===============================================================
# STEP 5: ASSOCIATION RULE MINING - APRIORI (from scratch)
# ===============================================================
def load_basket_matrix(conn):
    """Return boolean basket matrix: rows = orders, columns = products."""
    df = pd.read_sql_query("""
        SELECT oi.order_id, p.name AS product
        FROM order_items oi JOIN products p ON p.product_id = oi.product_id
    """, conn)
    basket = pd.crosstab(df["order_id"], df["product"]).clip(upper=1).astype(bool)
    return basket


def apriori(basket, min_support):
    """Level-wise Apriori. Returns {frozenset(items): support}."""
    M = basket.values
    cols = list(basket.columns)
    n = M.shape[0]

    def support(idx_tuple):
        return M[:, list(idx_tuple)].all(axis=1).sum() / n

    # L1
    freq = {}
    current = []
    for i in range(len(cols)):
        s = M[:, i].sum() / n
        if s >= min_support:
            freq[frozenset([cols[i]])] = s
            current.append((i,))
    k = 2
    while current:
        # candidate generation (join step) + prune step
        prev_set = set(current)
        cands = set()
        for a, b in combinations(current, 2):
            if a[:-1] == b[:-1]:
                cand = tuple(sorted(set(a) | set(b)))
                if all(sub in prev_set for sub in combinations(cand, k - 1)):
                    cands.add(cand)
        nxt = []
        for cand in cands:
            s = support(cand)
            if s >= min_support:
                freq[frozenset(cols[i] for i in cand)] = s
                nxt.append(cand)
        current = sorted(nxt)
        k += 1
    return freq


def generate_rules(freq, min_conf, min_lift):
    """Build rules A -> b (single-item consequent) from frequent itemsets."""
    rules = []
    for itemset, sup in freq.items():
        if len(itemset) < 2:
            continue
        for cons_item in itemset:
            ante = itemset - {cons_item}
            cons = frozenset([cons_item])
            conf = sup / freq[ante]
            lift = conf / freq[cons]
            if conf >= min_conf and lift >= min_lift:
                rules.append({
                    "antecedent": ", ".join(sorted(ante)),
                    "consequent": cons_item,
                    "support": round(sup, 4),
                    "confidence": round(conf, 4),
                    "lift": round(lift, 3),
                })
    if not rules:
        return pd.DataFrame()
    return (pd.DataFrame(rules)
            .sort_values(["lift", "confidence"], ascending=False)
            .reset_index(drop=True))


def run_association_mining(conn):
    banner("STEP 5: Association rule mining (Apriori)")
    basket = load_basket_matrix(conn)
    print(f"Basket matrix: {basket.shape[0]:,} transactions x "
          f"{basket.shape[1]} products")

    t = time.time()
    freq = apriori(basket, MIN_SUPPORT)
    print(f"Apriori finished in {time.time() - t:.2f}s | "
          f"frequent itemsets found: {len(freq)}")

    # Frequently purchased products
    singles = (pd.Series({list(k)[0]: v for k, v in freq.items() if len(k) == 1})
               .sort_values(ascending=False))
    print("\nTop 10 most frequently purchased products:")
    print(singles.head(10).round(4).to_string())
    singles.to_csv(f"{OUT_DIR}/frequent_products.csv", header=["support"])

    # Frequent itemsets of size >= 2
    multi = pd.DataFrame(
        [{"itemset": ", ".join(sorted(k)), "size": len(k), "support": round(v, 4)}
         for k, v in freq.items() if len(k) >= 2]
    ).sort_values("support", ascending=False)
    multi.to_csv(f"{OUT_DIR}/frequent_itemsets.csv", index=False)
    print(f"\nTop 10 frequent itemsets (size>=2):\n"
          f"{multi.head(10).to_string(index=False)}")

    rules = generate_rules(freq, MIN_CONFIDENCE, MIN_LIFT)
    rules.to_csv(f"{OUT_DIR}/association_rules.csv", index=False)
    print(f"\nRules generated: {len(rules)}")
    print("Top 10 rules by lift:")
    print(rules.head(10).to_string(index=False))

    # Chart 1: top products
    plt.figure(figsize=(8, 5))
    singles.head(12)[::-1].plot(kind="barh", color="#f0ad4e")
    plt.xlabel("Support (fraction of baskets)")
    plt.title("Top 12 Frequently Purchased Products")
    plt.tight_layout()
    plt.savefig(f"{OUT_DIR}/top_products.png", dpi=120)
    plt.close()

    # Chart 2: support vs confidence, coloured by lift
    if len(rules):
        plt.figure(figsize=(7, 5))
        sc = plt.scatter(rules["support"], rules["confidence"],
                         c=rules["lift"], cmap="viridis", s=60, edgecolor="k")
        plt.colorbar(sc, label="Lift")
        plt.xlabel("Support")
        plt.ylabel("Confidence")
        plt.title("Association Rules: Support vs Confidence")
        plt.tight_layout()
        plt.savefig(f"{OUT_DIR}/rules_scatter.png", dpi=120)
        plt.close()
    return rules


# ===============================================================
# STEP 6: CUSTOMER SEGMENTATION - RFM + K-MEANS
# ===============================================================
def run_clustering(conn):
    banner("STEP 6: Customer segmentation (RFM + K-Means)")
    rfm = pd.read_sql_query("""
        SELECT c.customer_id,
               CAST(julianday('2025-01-01') - julianday(MAX(o.order_date)) AS INT) AS recency,
               COUNT(DISTINCT o.order_id)                AS frequency,
               SUM(oi.quantity * p.price)                AS monetary
        FROM customers c
        JOIN orders o       ON o.customer_id = c.customer_id
        JOIN order_items oi ON oi.order_id   = o.order_id
        JOIN products p     ON p.product_id  = oi.product_id
        GROUP BY c.customer_id
    """, conn)
    print(f"RFM table built for {len(rfm):,} customers")

    # log-transform skewed features then scale
    X = rfm[["recency", "frequency", "monetary"]].copy()
    X["frequency"] = np.log1p(X["frequency"])
    X["monetary"] = np.log1p(X["monetary"])
    Xs = StandardScaler().fit_transform(X)

    # choose k using elbow (inertia) + silhouette
    ks, inertias, sils = list(range(2, 8)), [], []
    for k in ks:
        km = KMeans(n_clusters=k, n_init=10, random_state=SEED).fit(Xs)
        inertias.append(km.inertia_)
        sils.append(silhouette_score(Xs, km.labels_,
                                     sample_size=min(2000, len(Xs)),
                                     random_state=SEED))
    print("\n k | inertia  | silhouette")
    for k, i, s in zip(ks, inertias, sils):
        print(f" {k} | {i:8.1f} | {s:.3f}")
    best_k = 4        # business-friendly number of segments
    print(f"\nUsing k = {best_k} segments (best silhouette at k="
          f"{ks[int(np.argmax(sils))]})")

    fig, ax = plt.subplots(1, 2, figsize=(10, 4))
    ax[0].plot(ks, inertias, "o-")
    ax[0].set(title="Elbow Method", xlabel="k", ylabel="Inertia")
    ax[1].plot(ks, sils, "s-", color="green")
    ax[1].set(title="Silhouette Score", xlabel="k", ylabel="Score")
    plt.tight_layout()
    plt.savefig(f"{OUT_DIR}/choose_k.png", dpi=120)
    plt.close()

    km = KMeans(n_clusters=best_k, n_init=10, random_state=SEED).fit(Xs)
    rfm["cluster"] = km.labels_

    # name the segments from their average RFM profile
    prof = rfm.groupby("cluster")[["recency", "frequency", "monetary"]].mean()
    names = {}
    remaining = set(prof.index)
    c = prof.loc[list(remaining), "monetary"].idxmax();      names[c] = "Champions (high value)"; remaining.discard(c)
    c = prof.loc[list(remaining), "recency"].idxmax();       names[c] = "Lost / Churned";         remaining.discard(c)
    c = prof.loc[list(remaining), "frequency"].idxmax();     names[c] = "Loyal Regulars";         remaining.discard(c)
    for c in remaining:
        names[c] = "Occasional Buyers"
    rfm["segment"] = rfm["cluster"].map(names)

    summary = (rfm.groupby("segment")
               .agg(customers=("customer_id", "count"),
                    avg_recency_days=("recency", "mean"),
                    avg_orders=("frequency", "mean"),
                    avg_spend=("monetary", "mean"),
                    total_revenue=("monetary", "sum"))
               .round(1).sort_values("total_revenue", ascending=False))
    print("\nSegment summary:")
    print(summary.to_string())
    summary.to_csv(f"{OUT_DIR}/segment_summary.csv")
    rfm.to_csv(f"{OUT_DIR}/customer_segments.csv", index=False)

    # PCA 2-D scatter
    pts = PCA(n_components=2, random_state=SEED).fit_transform(Xs)
    plt.figure(figsize=(7, 5))
    for seg in rfm["segment"].unique():
        m = (rfm["segment"] == seg).values
        plt.scatter(pts[m, 0], pts[m, 1], s=10, label=seg, alpha=0.6)
    plt.legend()
    plt.xlabel("PCA 1")
    plt.ylabel("PCA 2")
    plt.title("Customer Segments (K-Means on RFM, PCA view)")
    plt.tight_layout()
    plt.savefig(f"{OUT_DIR}/customer_segments.png", dpi=120)
    plt.close()

    # Segment sizes pie
    plt.figure(figsize=(5, 5))
    summary["customers"].plot(kind="pie", autopct="%1.1f%%", ylabel="")
    plt.title("Customer Segment Distribution")
    plt.tight_layout()
    plt.savefig(f"{OUT_DIR}/segment_distribution.png", dpi=120)
    plt.close()
    return rfm


