def main():
    t_start = time.time()
    if os.path.exists(DB_FILE):
        os.remove(DB_FILE)
    conn = sqlite3.connect(DB_FILE)
    conn.execute("PRAGMA foreign_keys = ON")

    create_database(conn)       # CO1, CO2 - design + load
    demo_transaction(conn)      # CO2      - ACID
    demo_indexing(conn)         # CO3      - indexing / optimisation
    demo_distributed(conn)      # CO1,4,5  - sharding + consistency
    rules = run_association_mining(conn)   # data mining
    rfm = run_clustering(conn)             # data mining
    business_insights(conn, rules, rfm)

    conn.close()
    banner(f"DONE in {time.time() - t_start:.1f}s - results saved in {OUT_DIR}")
    for f in sorted(os.listdir(OUT_DIR)):
        print("  -", f)


