def create_database(conn):
    """Create schema and fill it with synthetic data (batch inserts)."""
    banner("STEP 1: Creating normalised schema & loading data")
    cur = conn.cursor()
    cur.executescript(SCHEMA)

    cur.executemany(
        "INSERT INTO products(name, category, price) VALUES (?,?,?)", PRODUCTS)
    name_to_id = {n: i + 1 for i, (n, _, _) in enumerate(PRODUCTS)}

    # Customers (with different "personalities" for clustering later)
    customers = []
    for cid in range(1, N_CUSTOMERS + 1):
        join = pd.Timestamp("2022-01-01") + pd.Timedelta(days=random.randint(0, 700))
        customers.append((cid, f"Customer_{cid}", random.choice(REGIONS),
                          join.strftime("%Y-%m-%d")))
    cur.executemany("INSERT INTO customers VALUES (?,?,?,?)", customers)

    # Customer behaviour types: loyal / regular / occasional / lapsed
    types = np.random.choice(
        ["loyal", "regular", "occasional", "lapsed"],
        size=N_CUSTOMERS, p=[0.15, 0.35, 0.30, 0.20])
    weights = np.array([{"loyal": 8, "regular": 4, "occasional": 1.5,
                         "lapsed": 1}[t] for t in types], dtype=float)
    weights /= weights.sum()
    start = pd.Timestamp("2024-01-01")
    end = pd.Timestamp("2024-12-31")
    span = (end - start).days

    orders, items = [], []
    price_idx = {n: p for n, _, p in PRODUCTS}
    all_names = list(name_to_id.keys())
    for oid in range(1, N_ORDERS + 1):
        c = np.random.choice(N_CUSTOMERS, p=weights)
        ctype = types[c]
        if ctype == "lapsed":                       # bought only early in the year
            day = random.randint(0, span // 3)
        elif ctype == "occasional":
            day = random.randint(0, span)
        else:
            day = int(np.random.beta(3, 1.5) * span)  # skewed to recent dates
        odate = (start + pd.Timedelta(days=day)).strftime("%Y-%m-%d")
        orders.append((oid, int(c) + 1, odate))

        basket = set()
        for pat, prob in PATTERNS:                  # planted patterns
            if random.random() < prob:
                basket.update(pat)
        for _ in range(random.randint(1, 5)):       # random extra items
            basket.add(random.choice(all_names))
        if not basket:
            basket.add(random.choice(all_names))
        for pname in basket:
            qty = random.randint(1, 3) if ctype != "loyal" else random.randint(1, 5)
            items.append((oid, name_to_id[pname], qty))

    t0 = time.time()
    cur.executemany("INSERT INTO orders VALUES (?,?,?)", orders)
    cur.executemany("INSERT INTO order_items VALUES (?,?,?)", items)
    conn.commit()
    print(f"Customers : {N_CUSTOMERS:,}")
    print(f"Products  : {len(PRODUCTS):,}")
    print(f"Orders    : {len(orders):,}")
    print(f"Line items: {len(items):,}")
    print(f"Batch insert time: {time.time() - t0:.2f}s")


# ===============================================================
# STEP 2: TRANSACTION HANDLING / ACID DEMO  (CO2)
# ===============================================================
def demo_transaction(conn):
    banner("STEP 2: ACID transaction demo (atomicity + rollback)")
    cur = conn.cursor()
    before = cur.execute("SELECT COUNT(*) FROM orders").fetchone()[0]
    try:
        cur.execute("BEGIN")
        cur.execute("INSERT INTO orders VALUES (999999, 1, '2024-12-31')")
        # This violates the CHECK constraint (quantity > 0) -> whole txn fails
        cur.execute("INSERT INTO order_items VALUES (999999, 1, -5)")
        conn.commit()
    except sqlite3.IntegrityError as e:
        conn.rollback()
        print(f"Constraint violated -> {e}")
        print("Transaction rolled back (Atomicity preserved).")
    after = cur.execute("SELECT COUNT(*) FROM orders").fetchone()[0]
    print(f"Orders before: {before:,} | after: {after:,} "
          f"-> {'CONSISTENT' if before == after else 'INCONSISTENT'}")


