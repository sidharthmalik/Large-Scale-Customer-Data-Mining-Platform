# STEP 7: BUSINESS INSIGHTS  (combine both mining techniques)
# ===============================================================
def business_insights(conn, rules, rfm):
    banner("STEP 7: Business insights & recommendations")
    if len(rules):
        r = rules.iloc[0]
        print(f"* Strongest rule : {r['antecedent']} -> {r['consequent']} "
              f"(lift {r['lift']}, confidence {r['confidence']:.0%})")
        print("  Action: bundle / place these products together; "
              "cross-sell on checkout.")
    seg = (rfm.groupby("segment")["monetary"].sum()
           .sort_values(ascending=False))
    share = seg / seg.sum()
    top = seg.index[0]
    print(f"* '{top}' brings {share.iloc[0]:.0%} of revenue "
          f"-> reward with loyalty offers.")
    if "Lost / Churned" in seg.index:
        print(f"* 'Lost / Churned' = {share['Lost / Churned']:.0%} of revenue "
              "-> run win-back campaigns.")

    # Segment-specific top products (SQL join with clusters)
    seg_map = rfm[["customer_id", "segment"]]
    seg_map.to_sql("tmp_segments", conn, if_exists="replace", index=False)
    df = pd.read_sql_query("""
        SELECT s.segment, p.name AS product, SUM(oi.quantity) AS units
        FROM tmp_segments s
        JOIN orders o       ON o.customer_id = s.customer_id
        JOIN order_items oi ON oi.order_id   = o.order_id
        JOIN products p     ON p.product_id  = oi.product_id
        GROUP BY s.segment, p.name
    """, conn)
    top3 = (df.sort_values("units", ascending=False)
              .groupby("segment").head(3)
              .sort_values(["segment", "units"], ascending=[True, False]))
    print("\nTop 3 products per segment:")
    print(top3.to_string(index=False))
    top3.to_csv(f"{OUT_DIR}/top_products_per_segment.csv", index=False)
    conn.execute("DROP TABLE IF EXISTS tmp_segments")


